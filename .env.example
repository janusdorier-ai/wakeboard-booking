NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Email of the bootstrap admin (gets role='admin' on first login)
APP_ADMIN_EMAIL=admin@example.com

# Public origin used in magic-link redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared passcode for the /party/admin console (party gamification feature).
# Not tied to Supabase Auth — whoever is running the party enters this to
# control trivia/predictions/photo missions live.
PARTY_ADMIN_PASSCODE=change-me
